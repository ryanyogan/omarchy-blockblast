[Desktop Entry]
Version=1.0
Type=Application
Name=Blast
GenericName=Block puzzle
Comment=Block Blast with vim keys and a global leaderboard
# One fixed-path command, no shell. The payload tells the overlay it was
# opened from the app menu, so it can dismiss the shell's "Launching…"
# feedback, which only a real window would otherwise satisfy. Backslashes
# are doubled per the desktop entry spec: the key-file layer eats one.
TryExec=/usr/bin/omarchy-shell
Exec=/usr/bin/omarchy-shell shell toggle ryanyogan.blast "{\\"launcher\\":true}"
Icon=blast
Terminal=false
Categories=Game;LogicGame;
Keywords=blocks;puzzle;game;vim;
StartupNotify=false
