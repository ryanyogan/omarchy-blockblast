{
  "schemaVersion": 1,
  "id": "ryanyogan.blast",
  "name": "Blast",
  "version": "1.2.5",
  "author": "Ryan Yogan",
  "license": "MIT",
  "description": "Block Blast for Omarchy. An 8x8 board, three pieces, vim keys, big combos, and a global leaderboard under a gamer tag. Launches as an app, no bar widget needed.",
  "homepage": "https://github.com/ryanyogan/omarchy-blockblast",
  "repository": "https://github.com/ryanyogan/omarchy-blockblast",
  "keywords": [
    "game",
    "puzzle",
    "blocks",
    "vim",
    "leaderboard"
  ],
  "kinds": [
    "bar-widget",
    "overlay",
    "service"
  ],
  "entryPoints": {
    "overlay": "Overlay.qml",
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "keepLoaded": false,
  "barWidget": {
    "displayName": "Blast",
    "description": "Block puzzle in the bar: the global leaderboard on click, the game on right click",
    "category": "Games",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showBest": false
    },
    "schema": [
      {
        "key": "showBest",
        "type": "boolean",
        "label": "Show best score next to the icon",
        "defaultValue": false
      }
    ]
  }
}